---
const { artist } = Astro.props;
---
<li class="artist-card">
  <a class="artist-card__link" href={`/artists/${artist.slug}/`}>
    <span class="artist-card__media">
      {artist.image
        ? <img src={artist.image} alt={artist.name} width="600" height="750" loading="lazy" decoding="async">
        : <span class="artist-card__placeholder" aria-hidden="true"><img src="/img/moon.svg" alt="" width="793" height="833"></span>}
    </span>
    <span class="artist-card__name">{artist.name}</span>
    <span class="artist-card__meta">{[artist.genre, artist.city].filter(Boolean).join(' · ')}</span>
  </a>
</li>
