---
import Layout from '../layouts/Layout.astro';
import { label, artists } from '../lib/data';
const topics = [
  { value: 'booking', label: 'Booking an artist' },
  { value: 'showcase', label: 'Label showcase / takeover' },
  { value: 'press', label: 'Press' },
  { value: 'business', label: 'Business & partnerships' },
  { value: 'licensing', label: 'Licensing & sync' },
  { value: 'other', label: 'Something else' },
];
const handle = label.socials.instagram.match(/instagram\.com\/([^/?#]+)/)?.[1];
---
<Layout title={`Bookings & press | ${label.name}`} description={`Book a ${label.shortName} artist or a label night, or get in touch for press and business.`} path="/contact/" current="contact">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="page-title">Bookings &amp; press</h1>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container contact">
      <div class="contact__intro">
        <p class="page-lead">Clubs, festivals, private events and brands: tell us the date, the place and who you want, and we come back with availability and a quote.</p>
        <ol class="steps">
          <li><strong>Send the details</strong>Date, venue and the artist or night you have in mind.</li>
          <li><strong>We check availability</strong>And reply with a quote and rider.</li>
          <li><strong>Lock it in</strong>Confirm and sign, and we take it from there.</li>
        </ol>
        <p class="contact__hint">Sending music? Use the <a href="/demos/">demo form</a>.{handle && <> Quick questions: <a href={label.socials.instagram} rel="noopener noreferrer">@{handle}</a>.</>}</p>
        {label.press.kitUrl && <p><a class="link-arrow" href={label.press.kitUrl} rel="noopener noreferrer">Download the press kit <svg class="icon icon--arrow" aria-hidden="true"><use href="#i-arrow"></use></svg></a></p>}
      </div>
      <form class="form" method="post" action="/api/contact" data-form data-contact-form novalidate>
        <div class="form__row">
          <div class="field"><label for="c-topic">What is it about?</label>
            <select id="c-topic" name="topic" required>{topics.map((t) => <option value={t.value}>{t.label}</option>)}</select>
          </div>
          <div class="field" data-booking-only><label for="c-artist">Artist</label>
            <select id="c-artist" name="artist">
              <option value="">Not sure yet</option>
              {artists.map((a) => <option value={a.slug}>{a.name}</option>)}
            </select>
          </div>
        </div>
        <div class="form__row" data-booking-only>
          <div class="field"><label for="c-date">Event date</label><input id="c-date" name="eventDate" type="date"></div>
          <div class="field"><label for="c-venue">Venue and city</label><input id="c-venue" name="venue" maxlength="150"></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" required maxlength="100"></div>
          <div class="field"><label for="c-org">Company / promoter / publication (optional)</label><input id="c-org" name="organisation" autocomplete="organization" maxlength="150"></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required maxlength="200"></div>
          <div class="field"><label for="c-phone">Phone / WhatsApp (optional)</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" maxlength="40"></div>
        </div>
        <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required maxlength="5000"></textarea></div>
        <div class="field field--hp" aria-hidden="true"><label for="c-web">Website</label><input id="c-web" name="website" tabindex="-1" autocomplete="off"></div>
        <p class="form__privacy">We use your details only to reply to this enquiry. See our <a href="/privacy/">Privacy Policy</a>.</p>
        <button class="btn btn--solid" type="submit" disabled>Send <svg class="icon icon--arrow" aria-hidden="true"><use href="#i-arrow"></use></svg></button>
        <p class="form__soon">This form goes live in the next update.</p>
      </form>
    </div>
  </section>
</Layout>
