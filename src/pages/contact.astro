---
import Layout from '../layouts/Layout.astro';
import { label } from '../lib/data';
const topics = ['Press', 'Business', 'Licensing & sync', 'Other'];
---
<Layout title={`Press & business contact | ${label.name}`} description={`Press, business and licensing enquiries for ${label.name}.`} path="/contact/" current="contact">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="page-title">Press &amp; business</h1>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container contact">
      <div class="contact__intro">
        <p class="page-lead">Journalists, promoters, brands and music supervisors: tell us what you need and we will get back to you.</p>
        <p class="contact__hint">Sending music? Please use the <a href="/demos/">demo form</a> instead.</p>
        {label.press.kitUrl && <p><a class="link-arrow" href={label.press.kitUrl} rel="noopener noreferrer">Download the press kit <svg class="icon icon--arrow" aria-hidden="true"><use href="#i-arrow"></use></svg></a></p>}
      </div>
      <form class="form" method="post" action="/api/contact" data-form novalidate>
        <div class="form__row">
          <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" required maxlength="100"></div>
          <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required maxlength="200"></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="c-org">Organisation / publication</label><input id="c-org" name="organisation" autocomplete="organization" maxlength="150"></div>
          <div class="field"><label for="c-topic">Topic</label>
            <select id="c-topic" name="topic" required>{topics.map((t) => <option>{t}</option>)}</select>
          </div>
        </div>
        <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required maxlength="5000"></textarea></div>
        <div class="field field--hp" aria-hidden="true"><label for="c-web">Website</label><input id="c-web" name="website" tabindex="-1" autocomplete="off"></div>
        <p class="form__privacy">We use your details only to reply to this enquiry. See our <a href="/privacy/">Privacy Policy</a>.</p>
        <button class="btn btn--solid" type="submit" disabled>Send enquiry <svg class="icon icon--arrow" aria-hidden="true"><use href="#i-arrow"></use></svg></button>
        <p class="form__soon">This form goes live in the next update.</p>
      </form>
    </div>
  </section>
</Layout>
