---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Midnight Children Records" path="/404/" noindex>
  <section class="page-head page-head--404">
    <div class="container">
      <img class="lost__moon" src="/img/moon.svg" alt="" width="793" height="833" aria-hidden="true">
      <p class="eyebrow">404</p>
      <h1 class="page-title">Lost after midnight</h1>
      <p class="page-lead">This page does not exist. Try the <a href="/releases/">releases</a> or go <a href="/">home</a>.</p>
    </div>
  </section>
</Layout>
